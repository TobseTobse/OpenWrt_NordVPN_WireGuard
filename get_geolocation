#!/bin/ash

COUNTRYNAMESFILE=/tmp/countries.json
SCRIPTDIR=$( cd "$( dirname "$0" )" && pwd )

# Load config
source $SCRIPTDIR/config/master_config
if [ -f "$SCRIPTDIR/config/my_config" ]; then
  source $SCRIPTDIR/config/my_config
fi

# Update TLD list
echo "[*] Updating countries list..."
GETCOUNTRIES=false
NOW=$(date +%s)
LIMIT=$((NOW - 60*60*24*30))
if [ ! -s "$COUNTRYNAMESFILE" ]; then
  GETCOUNTRIES=true
else
  FILEDATE=$(ls --full-time -l "$COUNTRYNAMESFILE" | awk '{print $6" "$7}')
  FILETS=$(date -d "$FILEDATE" +%s)
  if [ "$FILETS" -lt "$LIMIT" ]; then
    GETCOUNTRIES=true
  fi
fi

if [ "$GETCOUNTRIES" == "true" ]; then
  wget -q -T 10 -O $COUNTRYNAMESFILE https://country.io/names.json
fi

# count amount of URLs for IP address lookup from config
AMT=0
IPADDRESSURLS=$(echo $IPADDRESSURLS | tr "," "\n")
for IPADDRESSURL in $IPADDRESSURLS ; do
  let AMT=$AMT+1
done

# generate a random number for an entry from the IP address lookop URLs
RND=`awk -v min=1 -v max=$AMT 'BEGIN{srand(); print int(min+rand()*(max-min+1))}'`

# now pick the according URL from the list of lookup servers
CNT=0
TRIES=0
IPADDRESS=""

while [ "$TRIES" -le 10 ]; do
  for IPADDRESSURL in $IPADDRESSURLS ; do
    let CNT=$CNT+1
    if [ $CNT -eq $RND ]; then
      echo "[*] Determining external IP address via $IPADDRESSURL..."
      IPADDRESS=`wget -T 10 -q -O - $IPADDRESSURL 2>/dev/null`
      if [ "$IPADDRESS" == "" ]; then
        echo -e "\033[1;31m[!] Got no external IP - there's something rotten in the state of Denmark\033[0m"
      fi
      if [ $? -eq 0 ] || [ $CNT -gt $RND ]; then
        break
      fi
    fi
  done
  let TRIES=$TRIES+1
done

echo "[*] Getting geolocation information..."

COUNTRY=`wget -T 10 -q -O - https://ipinfo.io/country`
REGION=`wget -T 10 -q -O - https://ipinfo.io/region`
CITY=`wget -T 10 -q -O - https://ipinfo.io/city`
JSON=`wget -T 10 -q -O - https://ipinfo.io/json`

REGION=", $REGION"
if [ "$REGION" == ",  region" ]; then
  REGION=""
fi

COUNTRYNAME=`cat $COUNTRYNAMESFILE | \
grep -E -o "\"$COUNTRY\": \"[^\\"]{3,}\"" | grep -E -o '[^\"]{3,}'`
COUNTRYNAME=", $COUNTRYNAME"
ASN=`echo "$JSON" | sed -n 's/.*"org": "AS[0-9]* \(.*\)".*/\1/p'`

echo -e "\033[1;36m[>] Your external IP address: $IPADDRESS\033[0m"
echo -e "\033[1;36m[>] Location: $CITY$REGION$COUNTRYNAME\033[0m"

if [ "$ASN" != "" ]; then
  echo -e "\033[1;36m[>] ASN: $ASN\033[0m"
fi